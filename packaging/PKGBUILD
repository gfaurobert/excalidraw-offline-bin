# Maintainer: Gregoire <gregoire@faurobert.fr>
# Builds the Tauri 2 app from the GitHub source archive for tag v$pkgver.
pkgname=excalidraw-offline
pkgver=0.8.1
pkgrel=1
pkgdesc="Offline Excalidraw desktop app for local .excalidraw files (Tauri 2)"
arch=('x86_64')
url="https://github.com/gfaurobert/excalidraw-offline-bin"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'glib2' 'cairo' 'gdk-pixbuf2' 'libsoup3' 'dbus'
         'libgcc' 'glibc' 'hicolor-icon-theme')
# Rust/cargo and pnpm come from PATH (rustup, mise, corepack); only nodejs from pacman for -s.
makedepends=('nodejs')
options=('!lto' '!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$srcdir/excalidraw-offline-bin-$pkgver"
  # shellcheck source=/dev/null
  source packaging/pkgbuild-common.sh
  ensure_rust_toolchain
}

build() {
  cd "$srcdir/excalidraw-offline-bin-$pkgver"
  # shellcheck source=/dev/null
  source packaging/pkgbuild-common.sh
  excalidraw_offline_build
}

package() {
  cd "$srcdir/excalidraw-offline-bin-$pkgver"
  # shellcheck source=/dev/null
  source packaging/pkgbuild-common.sh
  excalidraw_offline_package
}
