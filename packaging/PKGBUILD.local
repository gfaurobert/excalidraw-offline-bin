# Local/source PKGBUILD for makepkg from a git checkout (no remote tarball).
# Usage from packaging/:
#   makepkg -si -f -p PKGBUILD.local
# Maintainer: Gregoire <gregoire@localhost>
pkgname=excalidraw-offline
pkgver=0.3.1
pkgrel=1
pkgdesc="Offline Excalidraw desktop app for local .excalidraw files (Deno Desktop wrapper)"
arch=('x86_64' 'aarch64')
url="https://github.com/gregoire/excalidraw-offline-bin"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'zenity' 'shared-mime-info' 'desktop-file-utils')
makedepends=('deno>=2.9.0')
source=()
sha256sums=()

prepare() {
  :
}

build() {
  cd "$startdir/.."
  export DENO_DIR="${SRCDEST:-$PWD}/.deno-cache"

  cd frontend
  deno install --node-modules-dir=auto
  deno task build
  cd ..

  mkdir -p dist/linux
  rm -rf dist/linux/excalidraw-offline
  deno desktop \
    -A \
    --backend=webview \
    --compress=xz \
    --include=./frontend/dist \
    --include=./icons \
    --include=./skills \
    --output=./dist/linux/excalidraw-offline \
    ./desktop/main.ts
}

package() {
  cd "$startdir/.."

  install -d "$pkgdir/usr/lib/$pkgname"
  cp -a dist/linux/excalidraw-offline/. "$pkgdir/usr/lib/$pkgname/"

  install -Dm755 packaging/excalidraw-offline.sh \
    "$pkgdir/usr/bin/excalidraw-offline"

  install -Dm644 packaging/excalidraw-offline.desktop \
    "$pkgdir/usr/share/applications/excalidraw-offline.desktop"
  install -Dm644 packaging/application-x-excalidraw.xml \
    "$pkgdir/usr/share/mime/packages/application-x-excalidraw.xml"
  install -Dm644 icons/icon.png \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/excalidraw-offline.png"

  if [[ -f LICENSE ]]; then
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  fi
}
