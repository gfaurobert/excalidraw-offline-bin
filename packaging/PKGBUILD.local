# Local/source PKGBUILD for makepkg from this git checkout (no remote tarball).
# Usage from packaging/:
#   makepkg -si -f -p PKGBUILD.local
# Maintainer: Gregoire <gregoire@faurobert.fr>
pkgname=excalidraw-offline
pkgver=0.8.0
pkgrel=1
pkgdesc="Offline Excalidraw desktop app for local .excalidraw files (Tauri 2)"
arch=('x86_64')
url="https://github.com/gfaurobert/excalidraw-offline-bin"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'glib2' 'cairo' 'gdk-pixbuf2' 'libsoup3' 'dbus'
         'libgcc' 'glibc' 'hicolor-icon-theme')
makedepends=('nodejs')
options=('!lto' '!debug')
source=()
sha256sums=()

prepare() {
  # shellcheck source=/dev/null
  source "$(dirname "${BUILDFILE}")/pkgbuild-common.sh"
  _local_srcroot="$(cd "$(dirname "${BUILDFILE}")/.." && pwd)"
  _buildroot="$srcdir/${pkgname}-build"
  prepare_local_build_tree "$_local_srcroot" "$_buildroot"
  ensure_rust_toolchain
}

build() {
  cd "$srcdir/${pkgname}-build"
  # shellcheck source=/dev/null
  source "$(dirname "${BUILDFILE}")/pkgbuild-common.sh"
  excalidraw_offline_build
}

package() {
  cd "$srcdir/${pkgname}-build"
  # shellcheck source=/dev/null
  source "$(dirname "${BUILDFILE}")/pkgbuild-common.sh"
  excalidraw_offline_package
}
