# Prebuilt binary package (no Rust/Node/pnpm build). Installs the GitHub Release Linux tarball.
# Usage from packaging/:
#   makepkg -si -f -p PKGBUILD-bin
# Maintainer: Gregoire <gregoire@faurobert.fr>
pkgname=excalidraw-offline-bin
pkgver=0.8.1
pkgrel=1
pkgdesc="Offline Excalidraw desktop app for local .excalidraw files (Tauri 2, prebuilt)"
arch=('x86_64')
url="https://github.com/gfaurobert/excalidraw-offline-bin"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'glib2' 'cairo' 'gdk-pixbuf2' 'libsoup3' 'dbus'
         'libgcc' 'glibc' 'hicolor-icon-theme')
makedepends=()
provides=('excalidraw-offline')
conflicts=('excalidraw-offline')
options=('!strip' '!debug')
source=("excalidraw-offline-${pkgver}-linux-x86_64.tar.gz::${url}/releases/download/v${pkgver}/excalidraw-offline-${pkgver}-linux-x86_64.tar.gz")
sha256sums=('f2f736e36c093c452c510fa8feb43661893007c02856465181b96ee436c42b5e')

package() {
  local tmp="${srcdir}/.unpack"
  rm -rf "$tmp"
  mkdir -p "$tmp"
  tar -xzf "$srcdir/excalidraw-offline-${pkgver}-linux-x86_64.tar.gz" -C "$tmp"
  local root="$tmp/usr"
  install -Dm755 "$root/bin/excalidraw-offline" "$pkgdir/usr/bin/excalidraw-offline"
  install -Dm644 "$root/share/applications/excalidraw-offline.desktop" \
    "$pkgdir/usr/share/applications/excalidraw-offline.desktop"
  install -Dm644 "$root/share/mime/packages/application-x-excalidraw.xml" \
    "$pkgdir/usr/share/mime/packages/application-x-excalidraw.xml"
  install -Dm644 "$root/share/icons/hicolor/128x128/apps/excalidraw-offline.png" \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/excalidraw-offline.png"
  install -Dm644 "$root/share/licenses/excalidraw-offline/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
